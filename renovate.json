{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": false,
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "14 days",
  "enabledManagers": ["docker-compose", "kubernetes", "flux"],
  "kubernetes": {
    "fileMatch": ["^204-k3s-prod/(manifests|infrastructure)/.*\\.ya?ml$"]
  },
  "flux": {
    "fileMatch": ["^204-k3s-prod/infrastructure/.*-helmrelease\\.ya?ml$"]
  }
}
